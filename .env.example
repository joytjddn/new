# 복사해서 .env 로 저장하고 값을 채우세요. (.env 는 git 에 올라가지 않습니다)

# 카카오 디벨로퍼스 > 내 애플리케이션 > REST API 키  (주소 좌표, 반경 동종 업소)
KAKAO_REST_KEY=

# 네이버 개발자센터 > 검색 API  (블로그 게시량)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 네이버 검색광고 > 도구 > API 사용 관리  (월 검색량 / 광고 경쟁)
NAVER_SEARCHAD_CUSTOMER_ID=
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET=

# 공공데이터포털(data.go.kr) 일반 인증키  (국세청 사업자 상태, 행안부 인구)
# - 국세청 사업자등록정보 진위확인 및 상태조회 서비스
# - 행정안전부 주민등록 인구 및 세대현황(행정동) 서비스 활용신청 필요
DATA_GO_KR_KEY=

# 선택
# ALLOWED_ORIGINS=https://joytjddn.github.io
# POPULATION_API_URL=
# PORT=8787
